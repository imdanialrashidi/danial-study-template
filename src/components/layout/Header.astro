---
/**
 * Header — sticky site chrome with brand, primary nav, search, and theme toggle.
 *
 * Brand treatment: a 36px monogram set against a hairline rule, then a
 * two-line wordmark (creator name + course title) with fixed leading so the
 * lockup aligns to the 16px header grid on desktop and mobile. Navigation sits
 * in the visual centre; utility actions dock at the RTL end.
 *
 * All identity values come from `src/config/site.ts` — never hard-code them.
 */
import Icon from '../ui/Icon.astro';
import { courseConfig } from '../../config/course';
import { creator } from '../../config/site';
import { withBase, stripBase } from '../../lib/url';

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;

// Routes are stored base-relative and resolved through withBase so the same
// source works at / and under a project-site prefix such as /physics2.
const navItems = [
  { href: '/lessons', label: 'درس‌ها', icon: 'book' },
  { href: '/concepts', label: 'مفاهیم', icon: 'layers' },
  { href: '/formulas', label: 'فرمول‌ها', icon: 'formula' },
  { href: '/practice', label: 'تمرین', icon: 'beaker' },
  { href: '/glossary', label: 'واژه‌نامه', icon: 'glossary' },
];

const isActive = (href: string) => {
  const path = stripBase(pathname);
  return path === href || path.startsWith(`${href}/`);
};
---

<header class="no-print sticky top-0 z-40 border-b border-line bg-canvas/90 backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-shell items-center gap-3 px-4 sm:gap-4 sm:px-6">
    <!-- Brand / creator identity: monogram + rule + wordmark as one lockup -->
    <a
      href={withBase('/')}
      class="group flex min-w-0 shrink-0 items-center gap-2.5"
      aria-label={`صفحهٔ اصلی — ${courseConfig.title}، ${creator.name}`}
    >
      <span
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-[6px] bg-primary font-display text-[15px] font-extrabold leading-none text-primary-on"
        aria-hidden="true"
      >
        د‌ر
      </span>
      <span class="hidden h-9 w-px shrink-0 bg-line sm:block" aria-hidden="true"></span>
      <span class="flex min-w-0 flex-col justify-center leading-none">
        <span class="truncate font-display text-[15px] font-extrabold leading-[1.35] tracking-tight text-ink">
          {creator.name}
        </span>
        <span class="mt-[3px] hidden max-w-[220px] truncate text-[11px] font-medium leading-[1.4] text-ink-muted sm:block lg:max-w-[260px]">
          {courseConfig.title}
        </span>
        {/* Mobile keeps a single line so the lockup never wraps or truncates mid-word. */}
        <span class="truncate text-[11px] font-medium leading-[1.4] text-ink-muted sm:hidden">
          درس‌نامهٔ آزاد
        </span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="mx-auto hidden items-center gap-1 lg:flex" aria-label="ناوبری اصلی">
      {
        navItems.map((item) => (
          <a
            href={withBase(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class={`inline-flex min-h-[40px] items-center gap-1.5 rounded-md px-3 py-1.5 text-sm transition-colors duration-fast ${
              isActive(item.href) ? 'bg-primary-wash font-bold text-primary-deep' : 'text-ink-muted hover:bg-surface-sunken hover:text-ink'
            }`}
          >
            <Icon name={item.icon as 'book'} size={16} />
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ms-auto flex items-center gap-1 lg:ms-0">
      <!-- Search: real link on desktop, opens the search page focus on mobile -->
      <a
        href={withBase('/search')}
        aria-label="جست‌وجو در دوره"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md text-ink-muted transition-colors duration-fast hover:bg-surface-sunken hover:text-ink"
      >
        <Icon name="search" size={19} />
      </a>

      <!-- Theme toggle: a tiny inline script, no React needed. -->
      <button
        type="button"
        data-theme-toggle
        aria-label="تغییر پوستهٔ روشن و تیره"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md text-ink-muted transition-colors duration-fast hover:bg-surface-sunken hover:text-ink"
      >
        <svg data-icon-sun width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <circle cx="10" cy="10" r="3.5" />
          <path d="M10 2v1.8M10 16.2V18M2 10h1.8M16.2 10H18M4.4 4.4l1.3 1.3M14.3 14.3l1.3 1.3M15.6 4.4l-1.3 1.3M5.7 14.3l-1.3 1.3" />
        </svg>
        <svg data-icon-moon width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="hidden" aria-hidden="true">
          <path d="M16.5 11.7A7 7 0 0 1 8.3 3.5a7 7 0 1 0 8.2 8.2z" />
        </svg>
      </button>

      <!-- Mobile menu -->
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="باز کردن منو"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md text-ink-muted transition-colors duration-fast hover:bg-surface-sunken hover:text-ink lg:hidden"
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>

  <!-- Mobile sheet -->
  <div id="mobile-nav" data-mobile-nav hidden class="border-t border-line bg-surface lg:hidden">
    <nav class="mx-auto max-w-shell px-4 py-4 sm:px-6" aria-label="ناوبری موبایل">
      <ul class="grid gap-1">
        {
          navItems.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class={`flex min-h-[48px] items-center gap-3 rounded-md px-3 py-2 text-sm ${
                  isActive(item.href) ? 'bg-primary-wash font-bold text-primary-deep' : 'text-ink hover:bg-surface-sunken'
                }`}
              >
                <Icon name={item.icon as 'book'} size={18} />
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-4 border-t border-line pt-4">
        <p class="mb-2 text-2xs font-bold tracking-wide text-ink-faint">ساختهٔ {creator.name}</p>
        <div class="flex flex-wrap gap-2">
          <a href={creator.github} rel="me noopener" target="_blank" class="inline-flex min-h-[44px] items-center gap-2 rounded-md border border-line px-3 py-2 text-sm text-ink-muted hover:border-primary hover:text-primary-deep">
            <Icon name="github" size={17} />
            گیت‌هاب
          </a>
          <a href={creator.instagram} rel="me noopener" target="_blank" class="inline-flex min-h-[44px] items-center gap-2 rounded-md border border-line px-3 py-2 text-sm text-ink-muted hover:border-primary hover:text-primary-deep">
            <Icon name="instagram" size={17} />
            اینستاگرام
          </a>
          <a href={creator.telegram} rel="me noopener" target="_blank" class="inline-flex min-h-[44px] items-center gap-2 rounded-md border border-line px-3 py-2 text-sm text-ink-muted hover:border-primary hover:text-primary-deep">
            <Icon name="telegram" size={17} />
            تلگرام
          </a>
          <a href={creator.website} rel="noopener" target="_blank" class="inline-flex min-h-[44px] items-center gap-2 rounded-md border border-line px-3 py-2 text-sm text-ink-muted hover:border-primary hover:text-primary-deep">
            <Icon name="globe" size={17} />
            وب‌سایت
          </a>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  // Progressive enhancement only: the header is fully usable as static HTML.
  // Arriving from the header's search button should land on a focused field.
  if (new URLSearchParams(location.search).get('focus') === 'search') {
    const url = new URL(location.href);
    url.searchParams.delete('focus');
    history.replaceState({}, '', url);
    requestAnimationFrame(() => document.getElementById('search-input')?.focus());
  }
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const mobileNav = document.querySelector<HTMLElement>('[data-mobile-nav]');

  menuButton?.addEventListener('click', () => {
    const open = mobileNav?.hasAttribute('hidden') === false;
    mobileNav?.toggleAttribute('hidden', open);
    menuButton.setAttribute('aria-expanded', String(!open));
    menuButton.setAttribute('aria-label', open ? 'باز کردن منو' : 'بستن منو');
  });

  const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const sun = document.querySelector('[data-icon-sun]');
  const moon = document.querySelector('[data-icon-moon]');

  const syncThemeIcon = () => {
    const isDark = document.documentElement.dataset.theme === 'dark';
    sun?.classList.toggle('hidden', isDark);
    moon?.classList.toggle('hidden', !isDark);
  };

  themeButton?.addEventListener('click', () => {
    const isDark = document.documentElement.dataset.theme === 'dark';
    const next = isDark ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('dr-theme', next);
    } catch {
      /* storage unavailable: theme still applies for this page view */
    }
    syncThemeIcon();
  });

  syncThemeIcon();
</script>
