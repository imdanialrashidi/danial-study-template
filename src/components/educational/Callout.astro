---
/**
 * Callout — an emphasized note, tip, warning, or danger block.
 *
 * Usage in MDX:
 *   <Callout type="tip" title="نکتهٔ کلیدی">متن توضیح</Callout>
 */
import Icon from '../ui/Icon.astro';

type CalloutType = 'note' | 'tip' | 'warning' | 'danger' | 'info';

interface Props {
  type?: CalloutType;
  title?: string;
  id?: string;
}

const { type = 'note', title, id } = Astro.props;

const config: Record<CalloutType, { icon: 'info' | 'bulb' | 'alert' | 'target'; label: string; classes: string; iconClass: string }> = {
  note: {
    icon: 'info',
    label: 'یادداشت',
    classes: 'border-line bg-surface-sunken/60',
    iconClass: 'text-ink-muted',
  },
  tip: {
    icon: 'bulb',
    label: 'نکته',
    classes: 'border-primary/30 bg-primary-wash',
    iconClass: 'text-primary-deep',
  },
  warning: {
    icon: 'alert',
    label: 'هشدار',
    classes: 'border-warning/40 bg-warning-soft',
    iconClass: 'text-warning',
  },
  danger: {
    icon: 'alert',
    label: 'خطر',
    classes: 'border-danger/40 bg-danger-soft',
    iconClass: 'text-danger',
  },
  info: {
    icon: 'target',
    label: 'نکتهٔ کلیدی',
    classes: 'border-accent/30 bg-accent-wash',
    iconClass: 'text-accent-deep',
  },
};

const cfg = config[type];
---

<aside
  id={id}
  class={`my-6 rounded-lg border-s-2 ${cfg.classes} px-5 py-4 text-body/95`}
  role="note"
  aria-label={title ?? cfg.label}
>
  <div class="mb-2 flex items-center gap-2">
    <Icon name={cfg.icon} size={17} class={cfg.iconClass} />
    <span class="text-xs font-bold tracking-wide text-ink-muted">{title ?? cfg.label}</span>
  </div>
  <div class="[&>*+*]:mt-3 [&>p]:leading-relaxed">
    <slot />
  </div>
</aside>