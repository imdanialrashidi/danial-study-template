---
/**
 * Misconception — a wrong belief stated plainly, then corrected.
 *
 * The `wrong` fragment is what learners often assume; `correct` is the accurate
 * statement. Showing both explicitly is one of the highest-value moves in
 * technical teaching, so this component never collapses the correction away.
 *
 * Usage in MDX:
 *   <Misconception wrong="مشتق همیشه مثبت است." correct="مشتق می‌تواند منفی، صفر یا ناموجود باشد." />
 */
interface Props {
  wrong: string;
  correct: string;
  title?: string;
}

const { wrong, correct, title = 'برداشت نادرست رایج' } = Astro.props;
---

<div class="misconception my-7 overflow-hidden rounded-lg border border-danger/40 bg-danger-soft/50">
  <div class="flex items-center gap-2 border-b border-danger/30 bg-danger-soft px-5 py-2.5">
    <span class="text-xs font-bold tracking-wide text-danger">{title}</span>
  </div>
  <div class="grid gap-0 sm:grid-cols-2 sm:divide-x sm:divide-danger/25 sm:divide-x-reverse">
    <div class="flex gap-3 px-5 py-4">
      <span class="mt-0.5 shrink-0 text-danger" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="m5.5 5.5 9 9M14.5 5.5l-9 9" /></svg>
      </span>
      <div>
        <p class="text-xs font-bold text-danger">اشتباه رایج</p>
        <p class="mt-1 text-sm leading-relaxed text-ink/90">{wrong}</p>
      </div>
    </div>
    <div class="flex gap-3 border-t border-danger/25 px-5 py-4 sm:border-t-0">
      <span class="mt-0.5 shrink-0 text-success" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m4 10.5 4 4 8-9" /></svg>
      </span>
      <div>
        <p class="text-xs font-bold text-success">تصحیح</p>
        <p class="mt-1 text-sm leading-relaxed text-ink/90">{correct}</p>
      </div>
    </div>
  </div>
</div>