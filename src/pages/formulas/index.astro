---
import ListingLayout from '../../layouts/ListingLayout.astro';
import { getEntriesByKind } from '../../lib/content';

const entries = await getEntriesByKind('formula');
---

<ListingLayout
  title="فرمول‌ها"
  description="فرمول‌های مشتق با معنی هر نماد، شرایط اعتبار و مثال کاربردی: تعریف مشتق و قاعدهٔ زنجیره‌ای. برای حل مسئله مستقیم استفاده کنید."
  entries={entries}
/>