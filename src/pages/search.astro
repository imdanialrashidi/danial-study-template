---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchIsland from '../islands/common/SearchIsland';
import { getAllEntries, buildSearchIndex } from '../lib/content';
import { toPersianDigits } from '../lib/utils';
import { isEnabled } from '../lib/features';

const searchIndex = buildSearchIndex(await getAllEntries());
const paletteOn = isEnabled('commandPalette');

// Idle-state entry points: the first four entries in course order. Deliberately
// not "popular searches" — there is no telemetry, so a popularity label would
// be invented evidence. Course order is real and useful.
const suggestions = searchIndex
  .slice(0, 4)
  .map(({ title, href, type }) => ({ title, href, type }));
---

<BaseLayout
  title="جست‌وجو"
  description="جست‌وجو در درس‌ها، مفاهیم، فرمول‌ها، مثال‌ها و واژه‌نامهٔ دوره."
  noindex={true}
  searchIndex={searchIndex}
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:py-16">
    <header class="mb-10">
      <h1 class="text-3xl">جست‌وجو</h1>
      <p class="mt-3 text-body leading-relaxed text-ink-muted">
        نام یک مفهوم، فرمول یا عنوان درس را بنویسید. جست‌وجو روی همهٔ
        {toPersianDigits(searchIndex.length)} مدخل دوره انجام می‌شود.
        {paletteOn && (
          <> از هر جای سایت هم با <kbd dir="ltr" class="rounded border border-line bg-surface-sunken px-1.5 py-0.5 font-mono text-[11px]">Ctrl/⌘ + K</kbd> یا <button type="button" data-open-palette class="font-bold text-primary-deep underline decoration-primary/40 underline-offset-4 hover:decoration-primary">باز کردن پالت فرمان</button> می‌توانید بگردید.</>
        )}
      </p>
    </header>

    <SearchIsland client:load suggestions={suggestions} />
  </div>
</BaseLayout>