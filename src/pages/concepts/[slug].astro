---
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getCollection } from 'astro:content';
import { getAllEntries, getSectionGroups, getCrossLinks, type CourseEntry } from '../../lib/content';
import { findEntryIndex } from '../../lib/resolve';

export async function getStaticPaths() {
  const concepts = await getCollection('concept', ({ data }) => data.draft !== true);
  const all = await getAllEntries();
  const sections = await getSectionGroups();

  return concepts.map((concept) => {
    const index = findEntryIndex(all, `concept/${concept.id}`);
    if (index === -1) {
      throw new Error(`concept/${concept.id} is missing from the content index`);
    }
    return {
      params: { slug: concept.id },
      props: {
        entry: all[index],
        sections,
        prev: index > 0 ? all[index - 1] : undefined,
        next: index < all.length - 1 ? all[index + 1] : undefined,
      },
    };
  });
}

interface Props {
  entry: CourseEntry;
  sections: Awaited<ReturnType<typeof getSectionGroups>>;
  prev?: CourseEntry;
  next?: CourseEntry;
}

const { entry, sections, prev, next } = Astro.props;
const crossLinks = await getCrossLinks(entry);
---

<ContentLayout entry={entry} sections={sections} crossLinks={crossLinks} prev={prev} next={next} />