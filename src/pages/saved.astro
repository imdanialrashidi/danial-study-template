---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import SavedList from '../islands/common/SavedList';
import { getAllEntries, getSectionGroups } from '../lib/content';
import { withBase } from '../lib/url';

const entries = (await getAllEntries()).map((e) => ({
  id: e.id,
  qualifiedId: e.qualifiedId,
  title: e.title,
  href: withBase(e.path),
  kind: e.kind,
  section: e.section,
}));
const sections = (await getSectionGroups())
  .filter((s) => s.entries.length > 0)
  .map((s) => ({ id: s.id, title: s.title }));
---

<BaseLayout
  title="نشان‌شده‌ها"
  description="صفحه‌هایی که برای مرور بعدی نشان کرده‌اید — درس‌ها، مفاهیم، فرمول‌ها و واژه‌ها، ذخیره‌شده در همین مرورگر."
  noindex={true}
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:py-16">
    <PageHeader
      title="نشان‌شده‌ها"
      description="هر صفحه‌ای را که نشان کنید، اینجا می‌ماند — روی همین مرورگر، بدون حساب کاربری."
    />

    <SavedList client:load entries={entries} sections={sections} />
  </div>
</BaseLayout>
