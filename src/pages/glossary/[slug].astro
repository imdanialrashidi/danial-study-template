---
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getCollection } from 'astro:content';
import { getAllEntries, getSectionGroups, getCrossLinks } from '../../lib/content';
import { findEntryIndex } from '../../lib/resolve';

export async function getStaticPaths() {
  const entries = await getCollection('glossary', ({ data }) => data.draft !== true);
  const sections = await getSectionGroups();

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { id: entry.id, sections },
  }));
}

interface Props {
  id: string;
  sections: Awaited<ReturnType<typeof getSectionGroups>>;
}

const { id, sections } = Astro.props;

const all = await getAllEntries();
const index = findEntryIndex(all, `glossary/${id}`);
if (index === -1) throw new Error(`glossary/${id} is missing from the content index`);
const projected = all[index];
const crossLinks = await getCrossLinks(projected);
---

<ContentLayout entry={projected} sections={sections} crossLinks={crossLinks} />
