---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import { getEntriesByKind, type CourseEntry } from '../../lib/content';
import { renderContent, mdxComponents } from '../../lib/render';
import { toPersianDigits } from '../../lib/utils';
import { withBase } from '../../lib/url';

const entries = (await getEntriesByKind('glossary')).sort((a, b) => a.title.localeCompare(b.title, 'fa'));

// Group by the first letter of the term so the index is scannable in Persian.
const groups = new Map<string, CourseEntry[]>();
for (const entry of entries) {
  const key = entry.title.trim().charAt(0) || '—';
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(entry);
}
const letters = [...groups.keys()].sort((a, b) => a.localeCompare(b, 'fa'));

// Render each entry body once for the inline definitions.
const rendered = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await renderContent(entry.entry);
    return { entry, Content };
  }),
);

// First-letter links for the jump bar.
const jumpTargets = [...groups.entries()].map(([letter, items]) => ({ letter, count: items.length }));
---

<BaseLayout
  title="واژه‌نامه"
  description="واژه‌های کلیدی دوره با تعریف دقیق و کوتاه، برای مرور سریع هنگام حل مسئله."
>
  <div class="mx-auto max-w-shell px-4 py-10 sm:px-6 lg:py-14">
    <header class="mb-8 max-w-2xl">
      <h1 class="text-3xl">واژه‌نامه</h1>
      <p class="mt-3 text-body leading-relaxed text-ink-muted">
        هر واژه یک بار و دقیق تعریف شده است. این فهرست برای مرور سریع هنگام حل مسئله ساخته شده —
        نه برای خواندن از ابتدا تا انتها.
      </p>
    </header>

    {
      entries.length === 0 ? (
        <div class="rounded-lg border border-dashed border-line-control bg-surface px-6 py-14 text-center">
          <Icon name="glossary" size={30} class="mx-auto text-ink-faint" />
          <p class="mt-3 font-display text-lg font-bold text-ink">واژه‌نامه خالی است</p>
          <p class="mt-2 text-sm text-ink-muted">
            برای افزودن، فایلی در <code class="font-mono text-xs">src/content/glossary/</code> بسازید.
          </p>
        </div>
      ) : (
        <>
          {/* Jump bar */}
          <nav aria-label="پرش به حرف" class="mb-10 flex flex-wrap gap-1.5">
            {jumpTargets.map(({ letter, count }) => (
              <a
                href={withBase(`/#letter-${encodeURIComponent(letter)}`)}
                class="inline-flex min-h-[40px] items-center gap-1 rounded-md border border-line bg-surface px-3 py-1.5 text-sm font-bold text-ink transition-colors duration-fast hover:border-primary hover:bg-primary-wash"
              >
                {letter}
                <span class="text-2xs font-normal text-ink-faint">{toPersianDigits(count)}</span>
              </a>
            ))}
          </nav>

          <div class="grid gap-10">
            {letters.map((letter) => (
              <section id={`letter-${encodeURIComponent(letter)}`} class="scroll-mt-24">
                <h2 class="mb-4 flex items-center gap-3 font-display text-2xl font-extrabold text-primary-deep">
                  {letter}
                  <span class="h-px flex-1 bg-line" aria-hidden="true" />
                </h2>
                <dl class="grid gap-x-8 gap-y-5 sm:grid-cols-2">
                  {rendered
                    .filter(({ entry }) => (groups.get(letter) ?? []).some((e) => e.id === entry.id))
                    .map(({ entry, Content }) => (
                      <div class="rounded-lg border border-line bg-surface px-5 py-4">
                        <dt class="font-display text-base font-bold text-ink">
                          <a href={withBase(entry.path)} class="hover:text-primary-deep">{entry.title}</a>
                        </dt>
                        <dd class="mt-1.5 text-sm leading-relaxed text-ink-muted">
                          <Content components={mdxComponents} />
                        </dd>
                      </div>
                    ))}
                </dl>
              </section>
            ))}
          </div>
        </>
      )
    }
  </div>
</BaseLayout>