---
/**
 * CourseLayout — wraps BaseLayout and adds the shared learning shell:
 * breadcrumb, the ruled teaching margin, a sidebar section index, and
 * prev/next navigation between entries.
 */
import BaseLayout from './BaseLayout.astro';
import SectionIndex from '../components/layout/SectionIndex.astro';
import PrevNextNav from '../components/layout/PrevNextNav.astro';
import Icon from '../components/ui/Icon.astro';
import BookmarkToggle from '../islands/common/BookmarkToggle';
import type { CourseEntry, SectionGroup } from '../lib/content';
import { SINGULAR_LABELS } from '../lib/content';
import { toPersianDigits } from '../lib/utils';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  entry?: CourseEntry;
  sections?: SectionGroup[];
  prev?: CourseEntry;
  next?: CourseEntry;
  noindex?: boolean;
  /** Hide the sidebar (used by wide single-column pages like search). */
  wide?: boolean;
}

const { title, description, entry, sections = [], prev, next, noindex, wide = false } = Astro.props;

const difficultyLabel = entry?.difficulty
  ? { beginner: 'مقدماتی', intermediate: 'متوسط', advanced: 'پیشرفته' }[entry.difficulty]
  : undefined;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  {/* Content pages use a narrower shell so the reading column and the contents
      rail sit together instead of floating at opposite ends of a 1200px band. */}
  <div class={`mx-auto px-4 py-8 sm:px-6 lg:py-10 ${wide ? 'max-w-shell' : 'max-w-5xl'}`}>
    <!-- Breadcrumb. Suppressed on the wide homepage (a self-link to «خانه»
         adds noise above the hero); content pages always show the trail. -->
    {!(wide && !entry) && (
    <nav aria-label="مسیر" class="mb-6 flex flex-wrap items-center gap-1.5 text-xs text-ink-muted">
      <a href={withBase('/')} class="transition-colors hover:text-primary-deep">خانه</a>
      {
        entry && (
          <>
            <Icon name="chevron-end" size={13} class="text-ink-faint" />
            <span class="text-ink-faint">{SINGULAR_LABELS[entry.kind]}</span>
            <Icon name="chevron-end" size={13} class="text-ink-faint" />
            <span class="truncate font-bold text-ink">{entry.title}</span>
          </>
        )
      }
    </nav>
    )}

    {/* Reading column + contents rail. Wide pages (homepage) own the full
        shell; content pages keep the capped reading measure beside the rail. */}
    <div class={wide ? '' : 'lg:flex lg:gap-10 xl:gap-14'}>
      <div class={wide ? 'min-w-0' : 'min-w-0 lg:max-w-measure'}>
        <!-- Entry header -->
        {
          entry && (
            <header class="mb-8">
              <div class="flex flex-wrap items-center gap-2 text-2xs font-bold tracking-wide">
                <span class="rounded-pill bg-primary-wash px-2.5 py-1 text-primary-deep">
                  {SINGULAR_LABELS[entry.kind]}
                </span>
                {difficultyLabel && (
                  <span class="rounded-pill border border-line bg-surface px-2.5 py-1 text-ink-muted">{difficultyLabel}</span>
                )}
                {entry.estimatedMinutes && (
                  <span class="inline-flex items-center gap-1 text-ink-faint">
                    <Icon name="clock" size={13} />
                    {toPersianDigits(entry.estimatedMinutes)} دقیقه
                  </span>
                )}
                {/* Bookmark is available immediately while reading; marking the
                    page finished stays at the end, where it belongs. */}
                <span class="ms-auto">
                  <BookmarkToggle client:idle id={entry.id} label={entry.title} />
                </span>
              </div>
              <h1 class="mt-3 text-3xl">{title}</h1>
              <p class="mt-3 max-w-measure text-body leading-relaxed text-ink-muted">{description}</p>
            </header>
          )
        }
        {
          !entry && !wide && (
            <header class="mb-8">
              <h1 class="text-3xl">{title}</h1>
              <p class="mt-3 max-w-measure text-body leading-relaxed text-ink-muted">{description}</p>
            </header>
          )
        }
        {/*
          When `wide` is set (the homepage supplies its own front-matter header),
          suppress the layout header so exactly one <h1> exists per page.
        */}

        <slot />
      </div>

      <!-- Sidebar: sticky section index on wide screens -->
      {!wide && sections.length > 0 && (
        <aside class="no-print hidden w-60 shrink-0 lg:block">
          <div class="sticky top-24">
            <SectionIndex sections={sections} currentId={entry?.id} />
          </div>
        </aside>
      )}
    </div>

    {(prev || next) && <PrevNextNav prev={prev} next={next} />}
  </div>
</BaseLayout>