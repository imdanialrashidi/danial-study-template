---
/**
 * BaseLayout — the HTML shell: <html dir="rtl">, SEO metadata, theme bootstrap,
 * and global styles. Everything else renders inside it.
 */
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { courseConfig } from '../config/course';
import { basePath, absoluteUrl, defaultOgImage, SEO } from '../config/site';
import { withBase } from '../lib/url';
import { themeStyleAttribute } from '../lib/themes';
import { isEnabled } from '../lib/features';
import { getAllEntries, buildSearchIndex } from '../lib/content';
import vazirmatnArabicUrl from '@fontsource-variable/vazirmatn/files/vazirmatn-arabic-wght-normal.woff2?url';
import estedadArabicUrl from '@fontsource-variable/estedad/files/estedad-arabic-wght-normal.woff2?url';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import TelegramPopup from '../components/ui/TelegramPopup.astro';
import CommandPalette from '../components/ui/CommandPalette.astro';

interface Props {
  title: string;
  description?: string;
  /** Extra CSS applied only on this page. */
  class?: string;
  /** Set true for pages that should not be indexed (e.g. search). */
  noindex?: boolean;
  /** `article` for entry pages; defaults to `website`. */
  ogType?: 'website' | 'article';
  /** Absolute share-image URL; defaults to the brand og:image. */
  ogImage?: string;
  /** ISO-8601 dates for article pages (meta + JSON-LD only when set). */
  publishedTime?: string;
  modifiedTime?: string;
  /** JSON-LD graphs, each rendered as its own inline script. */
  jsonLd?: Array<Record<string, unknown>>;
}

const {
  title,
  description = courseConfig.description,
  noindex = false,
  ogType = 'website',
  ogImage = defaultOgImage,
  publishedTime,
  modifiedTime,
  jsonLd = [],
} = Astro.props;

const pageTitle = title === courseConfig.title ? `${courseConfig.title} — ${SEO.defaultTitleSuffix}` : `${title} — ${courseConfig.title}`;
const canonical = absoluteUrl(Astro.url.pathname.replace(basePath, '') || '/');
const showPalette = isEnabled('commandPalette') && isEnabled('search');
const paletteIndex = showPalette ? buildSearchIndex(await getAllEntries()) : [];
---

<!doctype html>
<html lang={SEO.language} dir={SEO.dir} data-theme="light" data-course-accent style={themeStyleAttribute()}>
  <head>
    <ClientRouter />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Preload the two Arabic subsets that paint first-viewport text (body +
         display headings incl. the H1): without this the browser discovers
         them only after the stylesheet parses, delaying text LCP by ~1 RTT. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href={vazirmatnArabicUrl} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={estedadArabicUrl} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={courseConfig.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SEO.locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SEO.twitter} />
    <meta name="twitter:creator" content={SEO.twitter} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}

    <meta name="theme-color" content={SEO.themeColor} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={SEO.themeColorDark} media="(prefers-color-scheme: dark)" />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon-48.png')} type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} sizes="180x180" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <!--
      Apply the saved theme before first paint so there is no flash.
      This is the only inline script on the page; everything else is deferred.
    -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('dr-theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = saved || (prefersDark ? 'dark' : 'light');
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only-focusable absolute end-4 top-4 z-50 rounded-md bg-primary px-4 py-2 text-sm font-bold text-primary-on"
    >
      رفتن به محتوای اصلی
    </a>

    <Header pathname={Astro.url.pathname.replace(basePath, '') || '/'} />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />
    <TelegramPopup />
    {showPalette && <CommandPalette items={paletteIndex} />}
  </body>
</html>