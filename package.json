{
  "name": "study-danialrashidi-template",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable educational website template for study.danialrashidi.ir courses",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "npm run validate && npm run typecheck && npm run lint && npm run test && npm run build && npm run test:dist && npm run validate:links && npm run budgets",
    "validate": "node scripts/validate-content.mjs",
    "validate:links": "node scripts/validate-content.mjs --links",
    "typecheck": "astro check",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "budgets": "node scripts/check-budgets.mjs",
    "new:course": "node scripts/new-course.mjs",
    "new:lesson": "node scripts/new-content.mjs lesson",
    "new:concept": "node scripts/new-content.mjs concept",
    "new:formula": "node scripts/new-content.mjs formula",
    "new:question": "node scripts/new-content.mjs question",
    "new:example": "node scripts/new-content.mjs example",
    "new:glossary": "node scripts/new-content.mjs glossary",
    "visual-qa": "node scripts/visual-qa.mjs",
    "interaction-qa": "node scripts/interaction-qa.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:dist && npm run validate:links && npm run budgets",
    "verify:fast": "npm run test",
    "verify:feature": "npm run validate && npm run test && npm run build && npm run test:dist",
    "verify:full": "npm run ci",
    "test:dist": "vitest run tests/output",
    "test:all": "vitest run"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/react": "^3.6.3",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/tailwind": "^5.1.5",
    "@fontsource-variable/estedad": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "astro": "^5.18.0",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.2.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "katex": "^0.19.0",
    "playwright-core": "^1.56.0",
    "prettier": "^3.3.0",
    "prettier-plugin-astro": "^1.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
