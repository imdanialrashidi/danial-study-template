{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOMIterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    // Source and tests import siblings with explicit `.ts` extensions
    // (resolvable by Vite/vitest); allow them under typechecking.
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "useDefineForClassFields": false,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "moduleDetection": "strict",
    "libReplacement": false,
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.astro", ".astro/**/*.ts", "tests/**/*.ts", ".vercel_build_output/functions/entry.js"],
  "exclude": ["node_modules", ".cache", "dist"]
}
